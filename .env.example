# Copy to .env and fill in. .env is git-ignored.
# Authentication uses OAuth through a Databricks CLI profile:
#   databricks auth login --host <workspace-url> --profile <name>
# No personal access tokens or passwords are needed anywhere in this project.
DATABRICKS_CONFIG_PROFILE=<your-cli-profile>
# Serverless SQL warehouse id (databricks warehouses list)
BUNDLE_VAR_warehouse_id=<warehouse-id>
DATABRICKS_WAREHOUSE_ID=<warehouse-id>
# Printed by `databricks apps get pers-personalization` after the first deploy
PERS_APP_URL=<app-url>
